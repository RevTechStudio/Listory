@page "/counter"
@inject CounterViewModel ViewModel

<PageTitle>Counter</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Counter</MudText>

<MudText Typo="Typo.body1" Class="mb-4">Current count: @ViewModel.CurrentCount</MudText>

<MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="ViewModel.IncrementCountAction">Click me</MudButton>
